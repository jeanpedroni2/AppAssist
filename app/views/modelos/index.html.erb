<% content_for :title, "Modelos" %>

<h1 class="mb-4">Modelos</h1>

<% if notice %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="card">
  <div class="card-body">
    <table class="table table-bordered table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Descrição</th>
          <th>Marca</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @modelos.each do |modelo| %>
          <tr>
            <td><%= modelo.descricao %></td>
            <td><%= modelo.marca.try(:descricao) || "-" %></td>
            <td class="text-center">
              <%= link_to "Ver", modelo, class: "btn btn-info btn-sm me-1" %>
              <%= link_to "Editar", edit_modelo_path(modelo), class: "btn btn-warning btn-sm me-1" %>
              <%= link_to "Excluir", modelo, method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="d-flex justify-content-end mt-3">
      <%= link_to "Novo Modelo", new_modelo_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
