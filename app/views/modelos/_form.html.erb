<%= form_with(model: modelo, local: true) do |form| %>
  <% if modelo.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(modelo.errors.count, "erro") %> impediram o salvamento:</h5>
      <ul class="mb-0">
        <% modelo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :descricao, "Descrição", class: "form-label" %>
    <%= form.text_field :descricao, class: "form-control w-25", placeholder: "Ex: Inspiron 3000, Galaxy S22..." %>
  </div>

  <div class="mb-3">
    <%= form.label :marca_id, "Marca", class: "form-label" %>
    <%= form.collection_select :marca_id, Marca.all, :id, :descricao, { prompt: "Selecione a marca" }, class: "form-select w-25" %>
  </div>

  <div class="d-flex justify-content-end">
    <%= form.submit modelo.new_record? ? "Salvar" : "Atualizar", class: "btn btn-primary" %>
  </div>
<% end %>
