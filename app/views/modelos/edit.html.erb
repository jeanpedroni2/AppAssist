<% content_for :title, "Editar Modelo" %>

<div class="card">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">Editar Modelo</h5>
  </div>
  <div class="card-body">
    <%= render "form", modelo: @modelo %>
  </div>
  <div class="card-footer d-flex justify-content-between">
    <%= link_to "Visualizar", @modelo, class: "btn btn-info btn-sm" %>
    <%= link_to "Voltar à Lista", modelos_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>
