<% content_for :title, "Detalhes do Modelo" %>

<% if notice %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">Detalhes do Modelo</h5>
  </div>
  <div class="card-body">
    <%= render @modelo %>
  </div>
</div>

<div class="d-flex gap-2">
  <%= link_to "Editar", edit_modelo_path(@modelo), class: "btn btn-warning btn-sm" %>
  <%= link_to "Voltar", modelos_path, class: "btn btn-secondary btn-sm" %>
  <%= button_to "Excluir", @modelo, method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-danger btn-sm" %>
</div>
