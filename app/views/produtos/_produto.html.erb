<div id="<%= dom_id produto %>">
  <p>
    <strong>Descricao:</strong>
    <%= produto.descricao %>
  </p>

  <p>
    <strong>Tipoproduto:</strong>
    <%= produto.tipoproduto_id %>
  </p>

  <p>
    <strong>Valor:</strong>
    <%= produto.valor %>
  </p>

  <p>
    <strong>Marca:</strong>
    <%= produto.marca_id %>
  </p>

  <p>
    <strong>Unidademedida:</strong>
    <%= produto.unidademedida_id %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= produto.status %>
  </p>

  <p>
    <strong>Movestoque:</strong>
    <%= produto.movestoque %>
  </p>

</div>
