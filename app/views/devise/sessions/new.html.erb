<% content_for :title, "Login" %>

<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
    <div class="card-header text-center bg-primary text-white">
      <h4 class="mb-0">Assistência Técnica</h4>
    </div>

    <div class="card-body">
      <%= form_with(model: resource, as: resource_name, url: session_path(resource_name), html: { class: "needs-validation" }, local: true) do |f| %>
        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autofocus: true, class: "form-control form-control-sm" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-sm" %>
        </div>

        <div class="d-grid mb-3">
          <%= f.submit "Entrar", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>

      <div class="text-center mt-3">
        <%= link_to "Esqueci minha senha", new_password_path(resource_name), class: "text-muted small d-block" %>
        <%= link_to "Criar uma conta", new_registration_path(resource_name), class: "text-muted small d-block" %>
      </div>

    </div>
  </div>
</div>
