<div class="mt-3">
  <ul class="list-unstyled text-center small text-muted">
    <% if controller_name != 'sessions' %>
      <li><%= link_to "Já tem conta? Entrar", new_session_path(resource_name), class: "text-decoration-none" %></li>
    <% end %>

    <% if devise_mapping.registerable? && controller_name != 'registrations' %>
      <li><%= link_to "Criar uma conta", new_registration_path(resource_name), class: "text-decoration-none" %></li>
    <% end %>

    <% if devise_mapping.recoverable? && !%w[passwords registrations].include?(controller_name) %>
      <li><%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-decoration-none" %></li>
    <% end %>

    <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
      <li><%= link_to "Reenviar confirmação", new_confirmation_path(resource_name), class: "text-decoration-none" %></li>
    <% end %>

    <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
      <li><%= link_to "Reenviar instruções de desbloqueio", new_unlock_path(resource_name), class: "text-decoration-none" %></li>
    <% end %>

    <% if devise_mapping.omniauthable? %>
      <% resource_class.omniauth_providers.each do |provider| %>
        <li><%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "btn btn-outline-dark btn-sm mt-2" %></li>
      <% end %>
    <% end %>
  </ul>
</div>
