<%= form_with(model: categoria_equipamento, local: true) do |form| %>
  <% if categoria_equipamento.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(categoria_equipamento.errors.count, "erro") %> impedem o salvamento:</h5>
      <ul class="mb-0">
        <% categoria_equipamento.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :descricao, "Descrição", class: "form-label" %>
    <%= form.text_field :descricao, class: "form-control w-25", placeholder: "Ex: Informática, Eletrodomésticos..." %>
  </div>

  <div class="d-flex justify-content-end">
    <%= form.submit categoria_equipamento.new_record? ? "Salvar" : "Atualizar", class: "btn btn-primary" %>
  </div>
<% end %>
