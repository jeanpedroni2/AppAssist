<% content_for :title, "Categoria de Equipamento" %>

<% if notice %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">Detalhes da Categoria</h5>
  </div>
  <div class="card-body">
    <%= render @categoria_equipamento %>
  </div>
</div>

<div class="d-flex gap-2">
  <%= link_to "Editar", edit_categoria_equipamento_path(@categoria_equipamento), class: "btn btn-warning btn-sm" %>
  <%= link_to "Voltar", categoria_equipamentos_path, class: "btn btn-secondary btn-sm" %>
  <%= button_to "Excluir", @categoria_equipamento, method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-danger btn-sm" %>
</div>
