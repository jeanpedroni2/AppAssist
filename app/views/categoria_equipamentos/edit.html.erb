<% content_for :title, "Editar Categoria de Equipamento" %>

<div class="card">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">Editar Categoria de Equipamento</h5>
  </div>

  <div class="card-body">
    <%= render "form", categoria_equipamento: @categoria_equipamento %>
  </div>

  <div class="card-footer d-flex justify-content-between">
    <%= link_to "Visualizar", @categoria_equipamento, class: "btn btn-info btn-sm" %>
    <%= link_to "Voltar à Lista", categoria_equipamentos_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>
