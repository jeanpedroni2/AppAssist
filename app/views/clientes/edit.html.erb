<% content_for :title, "Editar Cliente" %>

<div class="card">
  <div class="card-header">
    <h2>Editar Cliente</h2>
  </div>

  <div class="card-body">
    <%= render "form", cliente: @cliente %>
  </div>

  <div class="card-footer d-flex justify-content-between">
    <%= link_to "Visualizar Cliente", @cliente, class: "btn btn-info" %>
    <%= link_to "Voltar à Lista", clientes_path, class: "btn btn-secondary" %>
  </div>
</div>
