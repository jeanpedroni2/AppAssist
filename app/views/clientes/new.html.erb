<div class="card">
  <div class="card-header">
    <h2>Novo Cliente</h2>
  </div>
  <div class="card-body">
    <%= form_with(model: @cliente, local: true) do |form| %>
      
      <div class="mb-3">
        <%= form.label :nome, class: "form-label" %>
        <%= form.text_field :nome, class: "form-control", placeholder: "Digite o nome do cliente", layout: "width: 25%;" %>
      </div>

      <div class="row mb-3">
        <div class="col-md-6">
          <%= form.label :cpf, class: "form-label" %>
          <%= form.text_field :cpf, class: "form-control", placeholder: "999.999.999-99", id: "cpf-input" %>
        </div>

        <div class="col-md-6">
          <%= form.label :telefone, class: "form-label" %>
          <%= form.text_field :telefone, class: "form-control", placeholder: "(99) 9 9999-9999", id: "telefone-input" %>
        </div>
      </div>
      
      <div class="row mb-3">
        <div class="col-md-5">
          <%= form.label :endereco, class: "form-label" %>
          <%= form.text_field :endereco, class: "form-control", placeholder: "Rua, Avenida, Travessa..." %>
        </div>

        <div class="col-md-1">
          <%= form.label :numero, class: "form-label" %>
          <%= form.text_field :numero, class: "form-control", placeholder: "Ex.: 1234" %>
        </div>

        <div class="col-md-2">
          <%= form.label :bairro, class: "form-label" %>
          <%= form.text_field :bairro, class: "form-control", placeholder: "Ex.: Centro" %>
        </div>

        <div class="col-md-2">
          <%= form.label :cep, class: "form-label" %>
          <%= form.text_field :cep, class: "form-control", placeholder: "99999-999", id: "cep-input" %>
        </div>

        <div class="col-md-2">
          <%= form.label :uf, class: "form-label" %>
          <%= form.select :uf, UfService.options_for_select, { prompt: "Selecione" }, { class: "form-select" } %>
        </div>
      </div>

      <div class="d-flex justify-content-between">
        <%= link_to 'Voltar', clientes_path, class: "btn btn-secondary" %>
        <%= form.submit 'Salvar Cliente', class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
