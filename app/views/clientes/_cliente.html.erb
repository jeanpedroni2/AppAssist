<div id="<%= dom_id cliente %>">
  <p>
    <strong>Nome:</strong>
    <%= cliente.nome %>
  </p>

  <p>
    <strong>CPF:</strong>
    <%= cliente.cpf %>
  </p>

  <p>
    <strong>Telefone:</strong>
    <%= cliente.telefone %>
  </p>

  <p>
    <strong>Endereço:</strong>
    <%= cliente.endereco %>
  </p>

  <p>
    <strong>Bairro:</strong>
    <%= cliente.bairro %>
  </p>

  <p>
    <strong>Numero:</strong>
    <%= cliente.numero %>
  </p>

  <p>
    <strong>CEP:</strong>
    <%= cliente.cep %>
  </p>

  <p>
    <strong>UF:</strong>
    <%= cliente.uf %>
  </p>

</div>
