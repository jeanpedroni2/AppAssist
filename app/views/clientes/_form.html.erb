<%= form_with(model: cliente, local: true) do |form| %>
  <% if cliente.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(cliente.errors.count, "erro") %> impedem o salvamento:</h4>
      <ul>
        <% cliente.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Nome, CPF, Telefone (cada um em linha separada) -->
  <div class="mb-3">
    <%= form.label :nome, class: "form-label" %>
    <%= form.text_field :nome, class: "form-control", style: "width=25%;" %>
  </div>

  <div class="mb-3">
    <%= form.label :cpf, class: "form-label" %>
    <%= form.text_field :cpf, class: "form-control", id: "cpf-input" %>
  </div>

  <div class="mb-3">
    <%= form.label :telefone, class: "form-label" %>
    <%= form.text_field :telefone, class: "form-control", id: "telefone-input" %>
  </div>

  <!-- Endereço, Bairro, Número, CEP, UF na mesma linha -->
  <div class="row mb-3">
    <div class="col-md-5">
      <%= form.label :endereco, class: "form-label" %>
      <%= form.text_field :endereco, class: "form-control" %>
    </div>

    <div class="col-md-3">
      <%= form.label :bairro, class: "form-label" %>
      <%= form.text_field :bairro, class: "form-control" %>
    </div>

    <div class="col-md-2">
      <%= form.label :numero, class: "form-label" %>
      <%= form.text_field :numero, class: "form-control" %>
    </div>

    <div class="col-md-2">
      <%= form.label :cep, class: "form-label" %>
      <%= form.text_field :cep, class: "form-control", id: "cep-input" %>
    </div>
  </div>

  <!-- UF -->
  <div class="mb-4">
    <%= form.label :uf, class: "form-label" %>
    <%= form.select :uf, UfService.options_for_select, { prompt: "Selecione" }, { class: "form-select" } %>
  </div>

  <!-- Botão -->
  <div class="d-flex justify-content-end">
    <%= form.submit cliente.new_record? ? "Salvar Cliente" : "Salvar Alterações", class: "btn btn-primary" %>
  </div>
<% end %>
