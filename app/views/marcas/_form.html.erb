<%= form_with(model: marca, local: true) do |form| %>
  <% if marca.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(marca.errors.count, "erro") %> impediram o salvamento:</h5>
      <ul class="mb-0">
        <% marca.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :descricao, "Descrição", class: "form-label" %>
    <%= form.text_field :descricao, class: "form-control", placeholder: "Ex: HP, Samsung, LG..." %>
  </div>

  <div class="d-flex justify-content-end">
    <%= form.submit marca.new_record? ? "Salvar" : "Atualizar", class: "btn btn-primary" %>
  </div>
<% end %>
