<% content_for :title, "Marcas" %>

<h1 class="mb-4">Marcas</h1>

<% if notice %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="card">
  <div class="card-body">
    <table class="table table-bordered table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Descrição</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @marcas.each do |marca| %>
          <tr>
            <td><%= marca.descricao %></td>
            <td class="text-center">
              <%= link_to "Ver", marca, class: "btn btn-info btn-sm me-1" %>
              <%= link_to "Editar", edit_marca_path(marca), class: "btn btn-warning btn-sm me-1" %>
              <%= link_to "Excluir", marca, method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="d-flex justify-content-end mt-3">
      <%= link_to "Nova Marca", new_marca_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
