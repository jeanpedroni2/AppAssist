<% content_for :title, "Editar Marca" %>

<div class="card">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">Editar Marca</h5>
  </div>
  <div class="card-body">
    <%= render "form", marca: @marca %>
  </div>
  <div class="card-footer d-flex justify-content-between">
    <%= link_to "Visualizar", @marca, class: "btn btn-info btn-sm" %>
    <%= link_to "Voltar à Lista", marcas_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>
